{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/skill-press/skill-press/main/schemas/release-attestation.schema.json",
  "title": "SkillPressReleaseAttestation",
  "description": "Canonical payload signed by the release-attestation key for one immutable Skill Press release.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "statementType",
    "locator",
    "namespace",
    "skill",
    "version",
    "artifactSha256",
    "artifactBytes",
    "artifactMediaType",
    "issuedAt",
    "submissionId",
    "automatedReviewSha256",
    "curatorDecisionSha256"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "statementType": { "const": "skillpress.release-attestation" },
    "locator": { "$ref": "#/definitions/locator" },
    "namespace": { "$ref": "#/definitions/name" },
    "skill": { "$ref": "#/definitions/name" },
    "version": { "$ref": "#/definitions/semver" },
    "artifactSha256": { "$ref": "#/definitions/digest" },
    "artifactBytes": { "type": "integer", "minimum": 1, "maximum": 67108864 },
    "artifactMediaType": { "const": "application/zip" },
    "issuedAt": { "$ref": "#/definitions/timestamp" },
    "submissionId": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{7,127}$"
    },
    "automatedReviewSha256": { "$ref": "#/definitions/digest" },
    "curatorDecisionSha256": { "$ref": "#/definitions/digest" }
  },
  "definitions": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "semver": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "locator": {
      "type": "string",
      "minLength": 3,
      "maxLength": 258,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*/[a-z0-9]+(?:-[a-z0-9]+)*@(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[.][0-9]{3}Z$"
    }
  }
}
