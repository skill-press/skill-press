{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/skill-press/skill-press/main/schemas/submission-resource.schema.json",
  "title": "SkillPressSubmissionResource",
  "description": "The canonical Skill Press server resource for a submitted candidate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "resourceType",
    "id",
    "idempotencyKey",
    "namespace",
    "status",
    "statusVersion",
    "sourceCommit",
    "artifactSha256",
    "projectVersion",
    "url",
    "receivedAt",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "resourceType": { "const": "skillpress.submission" },
    "id": { "$ref": "#/definitions/id" },
    "idempotencyKey": { "$ref": "#/definitions/digest" },
    "namespace": { "$ref": "#/definitions/namespace" },
    "status": { "$ref": "#/definitions/reviewStatus" },
    "statusVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "sourceCommit": { "$ref": "#/definitions/commit" },
    "artifactSha256": { "$ref": "#/definitions/digest" },
    "projectVersion": { "$ref": "#/definitions/semver" },
    "url": { "$ref": "#/definitions/url" },
    "receivedAt": { "$ref": "#/definitions/timestamp" },
    "updatedAt": { "$ref": "#/definitions/timestamp" },
    "release": { "$ref": "#/definitions/release" }
  },
  "allOf": [
    {
      "if": {
        "required": ["status"],
        "properties": { "status": { "const": "published" } }
      },
      "then": { "properties": { "release": {} }, "required": ["release"] },
      "else": {
        "not": { "properties": { "release": {} }, "required": ["release"] }
      }
    }
  ],
  "definitions": {
    "id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "namespace": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "semver": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[.][0-9]{3}Z$"
    },
    "url": {
      "type": "string",
      "maxLength": 2048,
      "pattern": "^https://skill-press[.]com/[A-Za-z0-9._~!$&'()*+,;=:@%/?-]*$"
    },
    "reviewStatus": {
      "type": "string",
      "enum": [
        "received",
        "automated-review",
        "curator-review",
        "changes-requested",
        "accepted",
        "published",
        "rejected"
      ]
    },
    "trustStatus": {
      "type": "string",
      "enum": ["trusted", "quarantined", "revoked"]
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locator",
        "version",
        "artifactSha256",
        "canonicalUrl",
        "attestationUrl",
        "trust"
      ],
      "properties": {
        "locator": {
          "type": "string",
          "minLength": 3,
          "maxLength": 240,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*/[a-z0-9]+(?:-[a-z0-9]+)*@(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
        },
        "version": { "$ref": "#/definitions/semver" },
        "artifactSha256": { "$ref": "#/definitions/digest" },
        "canonicalUrl": { "$ref": "#/definitions/url" },
        "attestationUrl": { "$ref": "#/definitions/url" },
        "trust": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "sequence", "updatedAt"],
          "properties": {
            "status": { "$ref": "#/definitions/trustStatus" },
            "sequence": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
            "updatedAt": { "$ref": "#/definitions/timestamp" },
            "reasonCode": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
            }
          }
        }
      }
    }
  }
}
