{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/skill-press/skill-press/main/schemas/skill-press.schema.json",
  "title": "SkillPressProject",
  "description": "The versioned project contract for a Skill Press-managed Agent Skill.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "project",
    "registry",
    "skill",
    "quality",
    "tests",
    "evaluation",
    "improve"
  ],
  "properties": {
    "schemaVersion": {
      "description": "The Skill Press configuration schema version.",
      "const": 2
    },
    "project": {
      "$ref": "#/definitions/project"
    },
    "registry": {
      "$ref": "#/definitions/registry"
    },
    "skill": {
      "$ref": "#/definitions/skill"
    },
    "quality": {
      "$ref": "#/definitions/quality"
    },
    "tests": {
      "$ref": "#/definitions/tests"
    },
    "evaluation": {
      "$ref": "#/definitions/evaluation"
    },
    "improve": {
      "$ref": "#/definitions/improve"
    }
  },
  "definitions": {
    "skillName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
    },
    "semver": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "description", "license", "repository", "author"],
      "properties": {
        "name": {
          "$ref": "#/definitions/skillName"
        },
        "version": {
          "$ref": "#/definitions/semver"
        },
        "description": {
          "type": "string",
          "minLength": 20,
          "maxLength": 280
        },
        "license": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9.+ -]*$"
        },
        "repository": {
          "type": "string",
          "maxLength": 240,
          "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+(?:\\.git)?$"
        },
        "author": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "github"],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "github": {
              "type": "string",
              "minLength": 1,
              "maxLength": 39,
              "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?$"
            }
          }
        }
      }
    },
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace"],
      "properties": {
        "namespace": {
          "$ref": "#/definitions/skillName"
        }
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path", "risk"],
      "properties": {
        "name": {
          "$ref": "#/definitions/skillName"
        },
        "path": {
          "$ref": "#/definitions/relativePath"
        },
        "risk": {
          "type": "string",
          "enum": ["low", "moderate", "high"]
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "readinessMinimum",
        "tesslQualityMinimum",
        "tesslImpactMinimum",
        "evidenceMaxAgeHours"
      ],
      "properties": {
        "readinessMinimum": {
          "type": "integer",
          "minimum": 90,
          "maximum": 100
        },
        "tesslQualityMinimum": {
          "type": "integer",
          "minimum": 90,
          "maximum": 100
        },
        "tesslImpactMinimum": {
          "type": "integer",
          "minimum": 90,
          "maximum": 100
        },
        "evidenceMaxAgeHours": {
          "type": "integer",
          "minimum": 1,
          "maximum": 720
        }
      }
    },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commands"],
      "properties": {
        "commands": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "argv", "timeoutSeconds"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._ -]*$"
              },
              "argv": {
                "type": "array",
                "minItems": 1,
                "maxItems": 32,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                }
              },
              "cwd": {
                "$ref": "#/definitions/relativePath"
              },
              "timeoutSeconds": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3600
              }
            }
          }
        }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repetitions", "minimumSuccessRate", "minimumImpactDelta", "sandbox", "network"],
      "properties": {
        "repetitions": {
          "type": "integer",
          "minimum": 3,
          "maximum": 20
        },
        "minimumSuccessRate": {
          "type": "number",
          "minimum": 0.9,
          "maximum": 1
        },
        "minimumImpactDelta": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 1
        },
        "sandbox": {
          "type": "string",
          "enum": ["docker", "podman"]
        },
        "network": {
          "type": "string",
          "enum": ["none", "restricted"]
        }
      }
    },
    "improve": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxIterations",
        "maxNoImprovement",
        "maxTokens",
        "maxCostUsd",
        "maxWallMinutes"
      ],
      "properties": {
        "maxIterations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "maxNoImprovement": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "maxTokens": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 10000000
        },
        "maxCostUsd": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000
        },
        "maxWallMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1440
        }
      }
    }
  }
}
