{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/mushanyoung/skillpress/main/schemas/eval-suite.schema.json",
  "title": "SkillPressEvaluationSuite",
  "description": "A versioned collection of behavioral evaluation scenarios.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "suite", "skill", "scenarios"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "suite": {
      "type": "string",
      "enum": ["training", "holdout"]
    },
    "skill": {
      "$ref": "#/definitions/portableName"
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "$ref": "#/definitions/scenario"
      }
    }
  },
  "definitions": {
    "portableName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "behaviorList": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "category", "shouldActivate", "prompt", "expectedBehavior"],
      "properties": {
        "id": {
          "$ref": "#/definitions/portableName"
        },
        "category": {
          "type": "string",
          "enum": ["positive", "near-miss", "failure", "adversarial"]
        },
        "shouldActivate": {
          "type": "boolean"
        },
        "prompt": {
          "type": "string",
          "minLength": 10,
          "maxLength": 8192
        },
        "expectedBehavior": {
          "$ref": "#/definitions/behaviorList"
        },
        "forbiddenBehavior": {
          "$ref": "#/definitions/behaviorList"
        },
        "fixture": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "files": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["path", "content"],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 240,
                    "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
                  },
                  "content": {
                    "type": "string",
                    "maxLength": 32768
                  }
                }
              }
            },
            "environment": {
              "type": "object",
              "maxProperties": 16,
              "propertyNames": {
                "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
              },
              "additionalProperties": {
                "type": "string",
                "maxLength": 4096
              }
            }
          }
        }
      }
    }
  }
}
