{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/skill-press/skill-press/main/schemas/reviewed-text-evidence.schema.json",
  "title": "SkillPressReviewedTextEvidence",
  "description": "Complete source-bound host-text measurement v1. Structural validation is not behavioral acceptance or execution attestation. Incomplete runs remain local checkpoints.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "evidenceType",
    "execution",
    "activationMeasurement",
    "runId",
    "createdAt",
    "suite",
    "rubric",
    "repetitions",
    "evaluationInputsSha256",
    "skillTextSha256",
    "plannedPairs",
    "unattemptedPairs",
    "complete",
    "records",
    "summary",
    "releaseEligible",
    "ineligibilityReasons",
    "source",
    "config",
    "artifact"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "evidenceType": {
      "const": "skillpress.reviewed-text-suite"
    },
    "execution": {
      "const": "host-networked-text"
    },
    "activationMeasurement": {
      "const": "harness-metadata-selection"
    },
    "runId": {
      "$ref": "#/definitions/digest"
    },
    "createdAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "suite": {
      "$ref": "eval-suite.schema.json"
    },
    "rubric": {
      "$ref": "eval-rubric.schema.json"
    },
    "repetitions": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "evaluationInputsSha256": {
      "$ref": "#/definitions/digest"
    },
    "skillTextSha256": {
      "$ref": "#/definitions/digest"
    },
    "plannedPairs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2560
    },
    "unattemptedPairs": {
      "const": 0
    },
    "complete": {
      "const": true
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2560,
      "items": {
        "$ref": "#/definitions/record"
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "readinessMinimum",
        "baselineSuccessRate",
        "withSkillSuccessRate",
        "impactDelta"
      ],
      "properties": {
        "readinessMinimum": {
          "type": "integer",
          "minimum": 90,
          "maximum": 100
        },
        "baselineSuccessRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "withSkillSuccessRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "impactDelta": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        }
      }
    },
    "releaseEligible": {
      "const": false
    },
    "ineligibilityReasons": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "const": "text_profile_not_admitted"
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "projectConfigSha256",
        "skillSha256",
        "evalSource",
        "evalSourceSha256"
      ],
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "projectConfigSha256": {
          "$ref": "#/definitions/digest"
        },
        "skillSha256": {
          "$ref": "#/definitions/digest"
        },
        "evalSource": {
          "const": "evals"
        },
        "evalSourceSha256": {
          "$ref": "#/definitions/digest"
        }
      }
    },
    "config": {
      "$ref": "skill-press.schema.json"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "bytes", "provenanceSha256"],
      "properties": {
        "sha256": {
          "$ref": "#/definitions/digest"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "provenanceSha256": {
          "$ref": "#/definitions/digest"
        }
      }
    }
  },
  "definitions": {
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "diagnostics",
        "usage",
        "releaseEligible",
        "requestedModel",
        "effort",
        "authentication",
        "cliVersion",
        "execution",
        "inputSha256",
        "outputSha256",
        "durationMs"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1048576
        },
        "diagnostics": {
          "type": "array",
          "maxItems": 1,
          "items": {
            "const": "Code Mode is unavailable because code-mode host is disabled. Code mode will fail closed; enable `features.code_mode_host` and install `codex-code-mode-host`."
          }
        },
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["inputTokens", "cachedInputTokens", "outputTokens"],
          "properties": {
            "inputTokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "cachedInputTokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "outputTokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        },
        "releaseEligible": {
          "const": false
        },
        "requestedModel": {
          "const": "gpt-6.1-sol"
        },
        "effort": {
          "const": "medium"
        },
        "authentication": {
          "const": "forced-chatgpt"
        },
        "cliVersion": {
          "const": "0.160.0"
        },
        "execution": {
          "const": "reviewed-host-text-pilot"
        },
        "inputSha256": {
          "$ref": "#/definitions/digest"
        },
        "outputSha256": {
          "$ref": "#/definitions/digest"
        },
        "durationMs": {
          "type": "number",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "diagnostics",
        "usage",
        "releaseEligible",
        "requestedModel",
        "effort",
        "authentication",
        "cliVersion",
        "execution",
        "inputSha256",
        "outputSha256",
        "durationMs",
        "selected",
        "rationale"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1048576
        },
        "diagnostics": {
          "type": "array",
          "maxItems": 1,
          "items": {
            "const": "Code Mode is unavailable because code-mode host is disabled. Code mode will fail closed; enable `features.code_mode_host` and install `codex-code-mode-host`."
          }
        },
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["inputTokens", "cachedInputTokens", "outputTokens"],
          "properties": {
            "inputTokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "cachedInputTokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "outputTokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        },
        "releaseEligible": {
          "const": false
        },
        "requestedModel": {
          "const": "gpt-6.1-sol"
        },
        "effort": {
          "const": "medium"
        },
        "authentication": {
          "const": "forced-chatgpt"
        },
        "cliVersion": {
          "const": "0.160.0"
        },
        "execution": {
          "const": "reviewed-host-text-pilot"
        },
        "inputSha256": {
          "$ref": "#/definitions/digest"
        },
        "outputSha256": {
          "$ref": "#/definitions/digest"
        },
        "durationMs": {
          "type": "number",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "selected": {
          "type": "boolean"
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    },
    "leg": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor", "judge", "criteria", "activated"],
      "properties": {
        "actor": {
          "$ref": "#/definitions/receipt"
        },
        "judge": {
          "$ref": "#/definitions/receipt"
        },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "score", "rationale"],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "score": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "rationale": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
            }
          }
        },
        "activated": {
          "type": "boolean"
        }
      }
    },
    "pair": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "baseline",
        "withSkill",
        "selection",
        "skillTextSha256",
        "activationMeasurement",
        "modelInvocations",
        "releaseEligible"
      ],
      "properties": {
        "kind": {
          "const": "skillpress.reviewed-selected-text-pair-pilot"
        },
        "baseline": {
          "$ref": "#/definitions/leg"
        },
        "withSkill": {
          "$ref": "#/definitions/leg"
        },
        "selection": {
          "$ref": "#/definitions/selection"
        },
        "skillTextSha256": {
          "$ref": "#/definitions/digest"
        },
        "activationMeasurement": {
          "const": "harness-metadata-selection"
        },
        "modelInvocations": {
          "const": 5
        },
        "releaseEligible": {
          "const": false
        }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runId",
        "scenarioId",
        "repetition",
        "status",
        "pair",
        "baselineScore",
        "withSkillScore"
      ],
      "properties": {
        "runId": {
          "$ref": "#/definitions/digest"
        },
        "scenarioId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "repetition": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "status": {
          "const": "passed"
        },
        "pair": {
          "$ref": "#/definitions/pair"
        },
        "baselineScore": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "withSkillScore": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      }
    }
  }
}
