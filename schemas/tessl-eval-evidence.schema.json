{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/mushanyoung/skillpress/main/schemas/tessl-eval-evidence.schema.json",
  "title": "SkillPressTesslEvalEvidence",
  "description": "Paired Impact evidence parsed from completed Tessl CLI eval results.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "evidenceType",
    "provider",
    "createdAt",
    "sourceCommit",
    "projectConfigSha256",
    "skillSha256",
    "scenarioSourceSha256",
    "cli",
    "runId",
    "agent",
    "model",
    "impactScore",
    "baselineScore",
    "impactDelta",
    "upliftRatio",
    "scenarios",
    "start",
    "result",
    "storagePath",
    "evidenceEligible",
    "ineligibilityReasons"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "evidenceType": { "const": "skillpress.tessl-eval" },
    "provider": { "const": "tessl" },
    "createdAt": { "$ref": "#/definitions/timestamp" },
    "sourceCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "projectConfigSha256": { "$ref": "#/definitions/digest" },
    "skillSha256": { "$ref": "#/definitions/digest" },
    "scenarioSourceSha256": { "$ref": "#/definitions/digest" },
    "cli": { "$ref": "#/definitions/cli" },
    "runId": { "type": "string", "minLength": 1, "maxLength": 200 },
    "agent": { "type": "string", "minLength": 1, "maxLength": 100 },
    "model": { "type": "string", "minLength": 1, "maxLength": 200 },
    "impactScore": { "type": "integer", "minimum": 0, "maximum": 100 },
    "baselineScore": { "type": "integer", "minimum": 0, "maximum": 100 },
    "impactDelta": { "type": "integer", "minimum": -100, "maximum": 100 },
    "upliftRatio": { "type": ["number", "null"], "minimum": 0 },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fingerprintSha256", "baselineScore", "withContextScore", "delta"],
        "properties": {
          "fingerprintSha256": { "$ref": "#/definitions/digest" },
          "baselineScore": { "type": "integer", "minimum": 0, "maximum": 100 },
          "withContextScore": { "type": "integer", "minimum": 0, "maximum": 100 },
          "delta": { "type": "integer", "minimum": -100, "maximum": 100 }
        }
      }
    },
    "start": { "$ref": "#/definitions/invocation" },
    "result": { "$ref": "#/definitions/invocation" },
    "storagePath": {
      "type": "string",
      "pattern": "^\\.skillpress/tessl/[a-f0-9]{64}$"
    },
    "evidenceEligible": { "type": "boolean" },
    "ineligibilityReasons": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "custom_executor",
          "dirty_inputs",
          "source_changed",
          "untrusted_cli",
          "missing_baseline",
          "scenario_regression"
        ]
      }
    }
  },
  "definitions": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[.][0-9]{3}Z$"
    },
    "cli": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "executableSha256", "commandSha256", "stdoutSha256", "stderrSha256"],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$"
        },
        "executableSha256": { "$ref": "#/definitions/digest" },
        "commandSha256": { "$ref": "#/definitions/digest" },
        "stdoutSha256": { "$ref": "#/definitions/digest" },
        "stderrSha256": { "$ref": "#/definitions/digest" }
      }
    },
    "invocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "commandSha256", "stdoutSha256", "stderrSha256"],
      "properties": {
        "passed": { "type": "boolean" },
        "commandSha256": { "$ref": "#/definitions/digest" },
        "stdoutSha256": { "$ref": "#/definitions/digest" },
        "stderrSha256": { "$ref": "#/definitions/digest" }
      }
    }
  }
}
