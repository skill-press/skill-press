{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/skill-press/skill-press/main/schemas/skill-lock.schema.json",
  "title": "SkillPressLockfile",
  "description": "Deterministic project lockfile for trusted Skill Press installations.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "lockfileType", "registry", "skills"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "lockfileType": { "const": "skillpress.lock" },
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "protocolVersion"],
      "properties": {
        "origin": { "const": "https://skill-press.com" },
        "protocolVersion": { "const": 1 }
      }
    },
    "skills": {
      "type": "array",
      "maxItems": 128,
      "items": { "$ref": "#/definitions/entry" }
    }
  },
  "definitions": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "keyId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "semver": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "locator": {
      "type": "string",
      "minLength": 3,
      "maxLength": 258,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*/[a-z0-9]+(?:-[a-z0-9]+)*@(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locator",
        "namespace",
        "skill",
        "version",
        "artifact",
        "attestation",
        "trust",
        "installedPath"
      ],
      "properties": {
        "locator": { "$ref": "#/definitions/locator" },
        "namespace": { "$ref": "#/definitions/name" },
        "skill": { "$ref": "#/definitions/name" },
        "version": { "$ref": "#/definitions/semver" },
        "artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sha256", "bytes"],
          "properties": {
            "sha256": { "$ref": "#/definitions/digest" },
            "bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 67108864
            }
          }
        },
        "attestation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sha256", "keyId"],
          "properties": {
            "sha256": { "$ref": "#/definitions/digest" },
            "keyId": { "$ref": "#/definitions/keyId" }
          }
        },
        "trust": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sequence", "status", "keyId", "sha256", "updatedAt"],
          "properties": {
            "sequence": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "status": { "const": "trusted" },
            "keyId": { "$ref": "#/definitions/keyId" },
            "sha256": { "$ref": "#/definitions/digest" },
            "updatedAt": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[.][0-9]{3}Z$"
            }
          }
        },
        "installedPath": {
          "type": "string",
          "pattern": "^[.]agents/skills/[a-z0-9]+(?:-[a-z0-9]+)*$"
        }
      }
    }
  }
}
