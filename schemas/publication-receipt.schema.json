{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/mushanyoung/skillpress/main/schemas/publication-receipt.schema.json",
  "title": "SkillPressPublicationReceipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "receiptType",
    "runId",
    "idempotencyKey",
    "sourceCommit",
    "artifactSha256",
    "projectVersion",
    "execute",
    "status",
    "createdAt",
    "updatedAt",
    "targets",
    "storagePath"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "receiptType": { "const": "skillpress.publication" },
    "runId": { "$ref": "#/definitions/digest" },
    "idempotencyKey": { "$ref": "#/definitions/digest" },
    "sourceCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "artifactSha256": { "$ref": "#/definitions/digest" },
    "projectVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
    "execute": { "type": "boolean" },
    "status": {
      "type": "string",
      "enum": ["dry_run", "blocked", "running", "failed", "completed"]
    },
    "createdAt": { "$ref": "#/definitions/timestamp" },
    "updatedAt": { "$ref": "#/definitions/timestamp" },
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": { "$ref": "#/definitions/target" }
    },
    "storagePath": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "string",
          "pattern": "^\\.skillpress/publications/[a-f0-9]{64}/receipt[.]json$"
        }
      ]
    }
  },
  "definitions": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[.][0-9]{3}Z$"
    },
    "preflight": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "code", "message"],
      "properties": {
        "ok": { "type": "boolean" },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
        },
        "message": { "type": "string", "minLength": 1, "maxLength": 280 }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status"],
      "properties": {
        "id": { "$ref": "#/definitions/identifier" },
        "status": { "type": "string", "enum": ["pending", "completed"] },
        "remoteId": { "type": "string", "minLength": 1, "maxLength": 512 },
        "url": { "type": "string", "minLength": 1, "maxLength": 2048 }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "capability", "auth", "rollback", "preflight", "status", "steps"],
      "properties": {
        "id": { "$ref": "#/definitions/identifier" },
        "capability": { "type": "string", "enum": ["publish", "submit", "derived"] },
        "auth": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Z][A-Z0-9_]*$"
          }
        },
        "rollback": { "type": "string", "minLength": 1, "maxLength": 280 },
        "preflight": { "$ref": "#/definitions/preflight" },
        "status": {
          "type": "string",
          "enum": ["planned", "preflight_failed", "running", "failed", "verified", "derived"]
        },
        "steps": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/definitions/step" }
        },
        "remoteId": { "type": "string", "minLength": 1, "maxLength": 512 },
        "url": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "errorCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
        }
      }
    }
  }
}
