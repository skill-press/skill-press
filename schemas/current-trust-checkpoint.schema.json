{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/skill-press/skill-press/main/schemas/current-trust-checkpoint.schema.json",
  "title": "SkillPressCurrentTrustCheckpoint",
  "description": "Short-lived signed binding from one release to its current trust event.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "statementType",
    "locator",
    "namespace",
    "skill",
    "version",
    "artifactSha256",
    "attestationSha256",
    "trustSequence",
    "trustStatus",
    "trustUpdatedAt",
    "trustEnvelopeSha256",
    "issuedAt",
    "expiresAt"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "statementType": { "const": "skillpress.current-trust-checkpoint" },
    "locator": { "$ref": "#/definitions/locator" },
    "namespace": { "$ref": "#/definitions/name" },
    "skill": { "$ref": "#/definitions/name" },
    "version": { "$ref": "#/definitions/semver" },
    "artifactSha256": { "$ref": "#/definitions/digest" },
    "attestationSha256": { "$ref": "#/definitions/digest" },
    "trustSequence": { "$ref": "#/definitions/sequence" },
    "trustStatus": { "$ref": "#/definitions/trustStatus" },
    "trustUpdatedAt": { "$ref": "#/definitions/timestamp" },
    "trustEnvelopeSha256": { "$ref": "#/definitions/digest" },
    "issuedAt": { "$ref": "#/definitions/timestamp" },
    "expiresAt": { "$ref": "#/definitions/timestamp" }
  },
  "definitions": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "semver": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "locator": {
      "type": "string",
      "minLength": 3,
      "maxLength": 258,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*/[a-z0-9]+(?:-[a-z0-9]+)*@(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[.][0-9]{3}Z$"
    },
    "trustStatus": { "type": "string", "enum": ["trusted", "quarantined", "revoked"] }
  }
}
