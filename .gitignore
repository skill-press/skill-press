# Skill Press keeps installed and transient local state out of source control.
/.agents/skills/
/.skill-lock.json.lock*
/.skill-lock.*.tmp
/.skill-lock.*.previous
.skill-press/improvements/
.skill-press/runs/
.skill-press/tessl/
.skill-press/tessl-evals/
.skill-press/submissions/
.skill-press/staging/
.skill-press/tmp/

# Legacy private state is never migrated or made trackable. Regenerate it under .skill-press/.
.skillpress/

# Local credentials and environment overrides are never package inputs.
.env
.env.*
!.env.example
*.pem
*.key

.DS_Store
